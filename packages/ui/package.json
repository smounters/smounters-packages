{
  "name": "@smounters/ui",
  "version": "2.0.1",
  "description": "HeroUI-based design layer: app shell with a resizable sidebar, a data table with per-user column settings, form drawer",
  "keywords": [
    "react",
    "heroui",
    "design-system",
    "data-table",
    "app-shell",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles-unthemed.css": "./dist/styles-unthemed.css",
    "./theme/palette.css": "./dist/theme/palette.css",
    "./theme/base.css": "./dist/theme/base.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smounters/smounters-packages.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/smounters/smounters-packages/tree/main/packages/ui#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/theme && cp src/styles.css src/styles-unthemed.css dist/ && cp src/theme/*.css dist/theme/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prepack": "pnpm run clean && pnpm run build",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "peerDependencies": {
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router-dom": ">=7"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-table": "^8.21.3"
  },
  "devDependencies": {
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/utils": "^3.1.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1"
  }
}
